# =============================================================================
# xbee_provision — Simplicity Studio 6 (VS Code / CMake GCC) project
# Based on Silicon Labs "Place a Project Under Source Control" (SSv6 User Guide):
#   https://docs.silabs.com/ssv6ug/latest/ssv6-project-under-source-control/
#
# TRACKED on purpose (do NOT add these here):
#   *.slcp, *.slps, *.slpb, *.slcw, *.pintool   project metadata
#   config/                                     component config (cannot be regenerated)
#   autogen/                                    tracked so CI / reviewers can build without Studio
#   vscode.conf, vscsolution.conf               tool versions (same policy as autogen)
#   cmake_gcc/CMakeLists.txt                    user-extensible build entry point
#   cmake_gcc/CMakeUserPresets.json             project presets; Studio never writes this file
#   cmake_gcc/toolchain.cmake                   not rewritten by the generator
#   app.c, app.h, main.c, readme.md, docs/      application sources and docs
# =============================================================================

# --- Simplicity Studio per-user / per-machine state --------------------------
.projectlinkstore
.uceditor/
.silabsExtContext
.trash/
trashed_modified_files/

# --- Regenerated by the Project Configurator on every generation -------------
# <project>.cmake and CMakePresets.json contain machine-specific SDK paths.
# Project presets belong in cmake_gcc/CMakeUserPresets.json, which CMake reads
# alongside this file and Studio never generates, so it is tracked.
cmake_gcc/*.cmake
!cmake_gcc/toolchain.cmake
cmake_gcc/CMakePresets.json

# SDK sources copied or linked into the project (import mode dependent)
simplicity_sdk_*/
gecko_sdk_*/

# --- Build output ------------------------------------------------------------
cmake_gcc/build/
# Build tree of the "provision" preset (cmake_gcc/CMakeUserPresets.json).
# Neither pattern above covers it: cmake_gcc/build/ is an exact name and
# cmake_gcc/*/build/ matches a build directory one level further down.
cmake_gcc/build-provision/
cmake_gcc/*/build/
artifact/
build/
GNU\ ARM*/
*.o
*.d
*.out
*.axf
*.elf
*.map
*.bin
*.hex
*.s37
*.rps
*.gbl

# --- VS Code extension (generated during build/debug) ------------------------
.vscode/

# --- OS / editor noise -------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*~
